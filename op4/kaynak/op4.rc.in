// op4 resource script (generated by CMake configure_file): icon, version info, application manifest.
#include <windows.h>

1 ICON "@OP4_SIMGE@"
1 24 "@OP4_BILDIRIM@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041f04b0"
        BEGIN
            VALUE "CompanyName", "Opus Fortis"
            VALUE "FileDescription", "op4"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "op4"
            VALUE "OriginalFilename", "op4.exe"
            VALUE "ProductName", "op4"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Opus Fortis"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x041f, 1200
    END
END
